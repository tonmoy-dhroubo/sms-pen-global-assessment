# Copy to .env and use ONE of the two parts below. Every other setting has a default (README: Environment variables).

# --- Part 1: without Docker (your own PostgreSQL; files kept in ./storage) -----------------------
# Replace "postgres:postgres" with your PostgreSQL superuser and its password (and the port if it is not 5432); the
# databases are created automatically by npm run db:reset and the integration tests (README: Run without Docker).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_test"
SESSION_SECRET="dev-only-insecure-secret-change-me-before-hosting"
STORAGE_DRIVER="filesystem"

# --- Part 2: with Docker (npm run services:up) ---------------------------------------------------
# Comment out part 1 and uncomment these.
# DATABASE_URL="postgresql://sms:sms@localhost:5432/sms"
# TEST_DATABASE_URL="postgresql://sms:sms@localhost:5432/sms_test"
# SESSION_SECRET="dev-only-insecure-secret-change-me-before-hosting"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="submissions"
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
