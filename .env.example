# Copy to `.env` (cp .env.example .env). The values below work as-is with `npm run services:up`.
# Only this file is committed; never put real credentials in it.

# --- Database ---------------------------------------------------------------------------------
# App connection. Hosted (Neon): the pooled connection string.
DATABASE_URL="postgresql://sms:sms@localhost:5432/sms"
# Used by Prisma migrations. Locally identical to DATABASE_URL. Hosted (Neon): the direct (non-pooled) URL.
DIRECT_URL="postgresql://sms:sms@localhost:5432/sms"
# Separate database for integration tests (created by docker/postgres/init). Local and CI only.
TEST_DATABASE_URL="postgresql://sms:sms@localhost:5432/sms_test"

# --- File storage (S3-compatible: MinIO locally, Supabase Storage when hosted) -----------------
# Endpoint the Next.js server uses to reach the storage service.
S3_ENDPOINT="http://localhost:9000"
# Endpoint embedded in presigned URLs, for the browser. Leave empty when the browser can reach S3_ENDPOINT
# (as locally). Set it when the server reaches storage on a different host than the browser does.
S3_PUBLIC_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="submissions"
# Locally these are also the MinIO root credentials used by docker-compose.yml.
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# "true" for both MinIO and Supabase (bucket in the path, not the hostname).
S3_FORCE_PATH_STYLE="true"

# --- Application ------------------------------------------------------------------------------
# IANA time zone used to display dates and judge deadlines (D-018).
APP_TIMEZONE="Asia/Dhaka"
# Signs the role cookie (D-020). This is a development-only placeholder (min. 32 characters);
# generate a real one for anything hosted:  openssl rand -base64 48
SESSION_SECRET="dev-only-insecure-secret-change-me-before-hosting"
# Maximum size of a submission file, in megabytes.
MAX_UPLOAD_MB="20"
# "true" shows the "Demo environment" banner (hosted demo only).
DEMO_MODE="false"

# --- Docker Compose only (not read by the app) --------------------------------------------------
# Postgres container: keep in sync with the credentials in DATABASE_URL above.
POSTGRES_USER="sms"
POSTGRES_PASSWORD="sms"
POSTGRES_DB="sms"
# Host ports. If one is taken on your machine, change it here and in the matching URL above.
POSTGRES_PORT="5432"
MINIO_API_PORT="9000"
MINIO_CONSOLE_PORT="9001"
# Browser origin allowed to PUT/GET/HEAD presigned URLs on MinIO (the app's URL).
APP_ORIGIN="http://localhost:3000"
