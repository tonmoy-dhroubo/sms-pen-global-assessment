// Source of truth for the data model. Keep db/er-diagram.md in sync (DB-001 to DB-020 in db/decisions.md).
//
// Conventions
// - Models are PascalCase singular, fields camelCase; tables are plural snake_case and columns snake_case,
//   mapped with @@map / @map. The ER diagram's UPPER_SNAKE entity names correspond to the models.
// - Ids are UUIDs generated by the database (gen_random_uuid()).
// - Money is numeric(12,2); marks are numeric(4,1); calendar dates are `date`; moments are timestamptz(3) (DB-002, DB-006).
// - Nothing financial or academic is deleted (DB-005): relations are `Restrict`, except PROGRAMME_MODULE.
// - Check constraints, extensions and the name-search index cannot be expressed here; they live in the first
//   migration (db/migrations/*_init/migration.sql).

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  // Needed for the partial unique index on payments.reference (voided payments free their reference, DB-024).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---------------------------------------------------------------------------------------

enum EnrolmentStatus {
  ENROLLED
  DEFERRED
  WITHDRAWN
  COMPLETED

  @@map("enrolment_status")
}

enum FeeChargeKind {
  PROGRAMME_FEE
  ADJUSTMENT
  WAIVER

  @@map("fee_charge_kind")
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  BKASH
  NAGAD
  CARD

  @@map("payment_method")
}

enum ReleaseStatus {
  DRAFT
  PUBLISHED
  WITHHELD

  @@map("release_status")
}

enum MarkChangeType {
  MARK
  PUBLISH
  WITHHOLD
  UNPUBLISH

  @@map("mark_change_type")
}

// --- Programmes, modules, staff ------------------------------------------------------------------

model Programme {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String @unique // e.g. BSC-CSE
  name          String
  durationYears Int    @map("duration_years")

  fees     ProgrammeFee[]
  modules  ProgrammeModule[]
  students Student[]

  @@map("programmes")
}

model ProgrammeFee {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programmeId  String   @map("programme_id") @db.Uuid
  academicYear String   @map("academic_year") // 2026-27
  instalment   Int // 1, 2, ...
  amount       Decimal  @db.Decimal(12, 2) // BDT
  dueDate      DateTime @map("due_date") @db.Date

  programme Programme   @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  charges   FeeCharge[]

  @@unique([programmeId, academicYear, instalment])
  @@index([dueDate])
  @@map("programme_fees")
}

model Module {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code  String @unique // e.g. CSE101
  title String

  programmes  ProgrammeModule[]
  assessments Assessment[]

  @@map("modules")
}

// Many-to-many join (DB-013). The only table whose rows cascade on delete.
model ProgrammeModule {
  programmeId String @map("programme_id") @db.Uuid
  moduleId    String @map("module_id") @db.Uuid

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  module    Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([programmeId, moduleId])
  @@index([moduleId])
  @@map("programme_modules")
}

model Staff {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName String @map("full_name")
  email    String @unique
  jobTitle String @map("job_title") // e.g. Registry Officer

  statusChanges  StatusChange[]
  payments       Payment[]      @relation("PaymentRecordedBy")
  voidedPayments Payment[]      @relation("PaymentVoidedBy")
  feeCharges     FeeCharge[]
  marks          Mark[]
  markChanges    MarkChange[]
  assessments    Assessment[]

  @@map("staff")
}

// --- Students ------------------------------------------------------------------------------------

model Student {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentNumber String          @unique @map("student_number") // SMS-2026-0001
  fullName      String          @map("full_name")
  email         String          @unique // lower-cased by the service (DB-007)
  dateOfBirth   DateTime        @map("date_of_birth") @db.Date
  programmeId   String          @map("programme_id") @db.Uuid
  academicYear  String          @map("academic_year") // current session, e.g. 2026-27 (DB-009)
  yearOfStudy   Int             @map("year_of_study") // 1, 2, 3, 4
  status        EnrolmentStatus @default(ENROLLED)
  version       Int             @default(1) // optimistic locking (DB-016)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  programme      Programme       @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  statusChanges  StatusChange[]
  feeCharges     FeeCharge[]
  payments       Payment[]
  submissions    Submission[]
  pendingUploads PendingUpload[]
  marks          Mark[]
  extensions     Extension[]

  @@index([programmeId])
  @@index([status])
  @@map("students")
}

// Issues Student IDs (DB-004, DB-015). Stands alone; no relations.
model StudentIdSequence {
  year      Int @id // session start year
  lastValue Int @map("last_value") // incremented in a transaction

  @@map("student_id_sequences")
}

model StatusChange {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  fromStatus  EnrolmentStatus? @map("from_status") // null on creation
  toStatus    EnrolmentStatus  @map("to_status")
  reason      String?
  changedById String           @map("changed_by_id") @db.Uuid
  changedAt   DateTime         @default(now()) @map("changed_at") @db.Timestamptz(3)

  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  changedBy Staff   @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([changedById])
  @@map("status_changes")
}

// --- Fees and payments ---------------------------------------------------------------------------

model FeeCharge {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  programmeFeeId String?       @map("programme_fee_id") @db.Uuid // null for adjustments and waivers
  kind           FeeChargeKind
  academicYear   String        @map("academic_year")
  description    String // e.g. Tuition 2026-27, instalment 1
  amount         Decimal       @db.Decimal(12, 2) // copied; negative for WAIVER (check constraint in migration)
  dueDate        DateTime      @map("due_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    String?       @map("created_by_id") @db.Uuid // staff who added it; null only for rows from before M10

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  programmeFee ProgrammeFee? @relation(fields: [programmeFeeId], references: [id], onDelete: Restrict)
  createdBy    Staff?        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([programmeFeeId])
  @@index([createdById])
  @@index([dueDate])
  @@map("fee_charges")
}

model Payment {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String        @map("student_id") @db.Uuid
  amount       Decimal       @db.Decimal(12, 2) // > 0 (check constraint in migration)
  method       PaymentMethod
  paidAt       DateTime      @map("paid_at") @db.Date
  reference    String // stored trimmed and upper-cased; unique among payments that are not voided (partial index, see below)
  recordedById String        @map("recorded_by_id") @db.Uuid
  recordedAt   DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(3)
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz(3) // never deleted, only voided (DB-005)
  voidedById   String?       @map("voided_by_id") @db.Uuid // set together with voidedAt (check constraint)
  voidReason   String?       @map("void_reason")

  student    Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy Staff   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   Staff?  @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@unique([reference], where: raw("voided_at IS NULL"), map: "payments_reference_active_key")
  @@index([studentId])
  @@index([recordedById])
  @@index([voidedById])
  @@map("payments")
}

// --- Assessments and submissions -----------------------------------------------------------------

model Assessment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId    String    @map("module_id") @db.Uuid
  title       String
  deadline    DateTime  @db.Timestamptz(3)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(3) // no uploads at all after this
  version     Int       @default(1) // optimistic locking (DB-016)
  createdById String    @map("created_by_id") @db.Uuid

  module         Module          @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  createdBy      Staff           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  submissions    Submission[]
  pendingUploads PendingUpload[]
  marks          Mark[]
  extensions     Extension[]

  @@index([moduleId])
  @@index([createdById])
  @@index([deadline])
  @@map("assessments")
}

// Per-student deadline extension (DB-014, stretch goal).
model Extension {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  newDeadline  DateTime @map("new_deadline") @db.Timestamptz(3)
  reason       String

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@map("extensions")
}

// Backs the three-step upload flow (D-013, DB-017).
model PendingUpload {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String    @map("assessment_id") @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  objectKey    String    @unique @map("object_key")
  originalName String    @map("original_name") // as the student named it; copied to SUBMISSION_FILE at confirm
  mimeType     String    @map("mime_type") // declared at issue; PDF or DOCX
  sizeBytes    Int       @map("size_bytes") // declared at issue; the presigned PUT signs it and confirm re-checks it
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(3) // null until confirmed

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([assessmentId])
  @@index([studentId])
  @@index([expiresAt])
  @@map("pending_uploads")
}

model Submission {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId     String   @map("assessment_id") @db.Uuid
  studentId        String   @map("student_id") @db.Uuid
  firstSubmittedAt DateTime @map("first_submitted_at") @db.Timestamptz(3)
  lastSubmittedAt  DateTime @map("last_submitted_at") @db.Timestamptz(3)

  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  files      SubmissionFile[]

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@map("submissions")
}

// One row per uploaded version; every version is kept (DB-005).
model SubmissionFile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  objectKey    String   @unique @map("object_key") // S3 key, server-generated
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type") // PDF or DOCX
  sizeBytes    Int      @map("size_bytes")
  sha256       String // receipt fingerprint
  uploadedAt   DateTime @map("uploaded_at") @db.Timestamptz(3) // when the file arrived

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([submissionId])
  @@map("submission_files")
}

// --- Marks ---------------------------------------------------------------------------------------

// MARK and SUBMISSION are not linked directly: both are keyed on (assessment, student).
model Mark {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId    String        @map("assessment_id") @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  mark            Decimal?      @db.Decimal(4, 1) // 0-100, 1 dp; null when non-submission (check constraints in migration)
  isNonSubmission Boolean       @default(false) @map("is_non_submission")
  releaseStatus   ReleaseStatus @default(DRAFT) @map("release_status")
  withheldReason  String?       @map("withheld_reason")
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(3)
  version         Int           @default(1) // optimistic locking (DB-016)
  enteredById     String        @map("entered_by_id") @db.Uuid
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  assessment Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enteredBy  Staff        @relation(fields: [enteredById], references: [id], onDelete: Restrict)
  changes    MarkChange[]

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([enteredById])
  @@index([releaseStatus])
  @@map("marks")
}

// Audit trail for marks and release changes (DB-020).
model MarkChange {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  markId      String         @map("mark_id") @db.Uuid
  change      MarkChangeType
  oldMark     Decimal?       @map("old_mark") @db.Decimal(4, 1)
  newMark     Decimal?       @map("new_mark") @db.Decimal(4, 1)
  reason      String? // required once published (enforced by the service)
  changedById String         @map("changed_by_id") @db.Uuid
  changedAt   DateTime       @default(now()) @map("changed_at") @db.Timestamptz(3)

  mark      Mark  @relation(fields: [markId], references: [id], onDelete: Restrict)
  changedBy Staff @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([markId])
  @@index([changedById])
  @@map("mark_changes")
}
