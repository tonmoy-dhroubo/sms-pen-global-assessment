# Normalise all text files to LF in the repository and in the working tree.
* text=auto eol=lf

# Binary files: never touch line endings or attempt text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.woff binary
*.woff2 binary
